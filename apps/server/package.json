{
  "name": "foreman-server",
  "private": true,
  "version": "0.0.0",
  "description": "Express API, Prisma schema, dual auth, webhook receiver and CLI",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "exports": {
    "./config": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./db": {
      "types": "./src/db.ts",
      "default": "./dist/db.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./dist/logger.js"
    },
    "./jobs": {
      "types": "./src/jobs/index.ts",
      "default": "./dist/jobs/index.js"
    },
    "./boot": {
      "types": "./src/boot.ts",
      "default": "./dist/boot.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @foreman/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:example": "pnpm --filter @foreman/shared build && node --env-file-if-exists=../../.env --import tsx src/cli/seed-example.ts",
    "import": "pnpm --filter @foreman/shared build && node --env-file-if-exists=../../.env --import tsx src/cli/import.ts",
    "relint": "pnpm --filter @foreman/shared build && node --env-file-if-exists=../../.env --import tsx src/cli/relint.ts",
    "reconcile-status": "pnpm --filter @foreman/shared build && node --env-file-if-exists=../../.env --import tsx src/cli/reconcile-status.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@d3cloud/foreman-mcp": "workspace:*",
    "@d3cloudio/auth-client": "0.1.1",
    "@foreman/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  }
}
