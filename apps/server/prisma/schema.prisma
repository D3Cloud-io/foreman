// Foreman schema. The shape's source of truth is D3 Cloud Vault/Foreman/Data Model.md, and the
// enums mirror packages/shared/src/enums.ts value for value (FRM-REQ-003).
//
// Three details the plan singles out as expensive to get wrong later, all settled here:
//   1. `phase.number` is numeric, not integer — Bindery shipped a Phase 8.5.
//   2. `phase.sort_order` is independent of `phase.number` — Bindery built 0–8.5, 9–11, 13–16.
//   3. `requirement.phase_id` is nullable — an unassigned requirement is the backlog.
//
// Deletion is soft everywhere (`deleted_at`), and every mutation writes an `audit_event`, which is
// also the substrate for undo.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (mirror packages/shared/src/enums.ts) ───────────────────────────

enum ProjectLifecycle {
  planned
  scaffolded
  building
  deployed
  parked
  scrapped
}

enum PhaseStatus {
  planned
  active
  complete
  cancelled
  parked
}

/// T-shirt sizes only. Foreman records no time estimates anywhere.
enum Size {
  XS
  S
  M
  L
  XL
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

/// MoSCoW.
enum Priority {
  M
  S
  C
  W
}

/// `unparsed` is a legal stored state: the EARS lint warns, it never blocks.
enum EarsPattern {
  ubiquitous
  state
  event
  unwanted
  optional
  complex
  unparsed
}

enum AdrStatus {
  proposed
  accepted
  superseded
  rejected
}

enum AdrRelationKind {
  extends
  supersedes
  superseded_by
}

/// A project idea's states. `converted` is reachable by converting and by nothing else.
/// A project idea's states, ordered so that open work sorts before decided work.
///
/// `shortlisted` and `funded` exist for the innovation-fund board (FRM-ADR-016) and are offered
/// only in `board` mode; `converted` is the solo instance's end state — it became a Foreman
/// project. `parked` and `rejected` are the two off-ramps in both, and both demand a reason.
enum ProjectIdeaStatus {
  new
  considering
  shortlisted
  funded
  parked
  rejected
  converted
}

/// What a person may do. One role per account, per deployment — deployments do not share a
/// database, so there is nothing for a second dimension to scope to (FRM-ADR-016).
enum UserRole {
  /// Everything, plus managing members.
  admin
  /// The board: sees every submission, scores, comments internally, and decides.
  reviewer
  /// Submits and discusses. Sees the board; edits only their own.
  submitter
}

enum RiskLevel {
  low
  medium
  high
}

enum RiskStatus {
  open
  fired
  closed
}

/// Document kinds are data, not a migration (ADR-006). The five registers that used to be files
/// are views over tables, and are deliberately absent.
enum DocumentKind {
  architecture
  data_model
  api_contract
  ux_flows
  research
  discovery
  phase_plan
  test_strategy
  feature_ideas
  overview
  runbook
}

enum AuditKind {
  code_review
  design
  feature
  api
}

enum AuditStatus {
  running
  complete
  abandoned
}

enum Severity {
  critical
  high
  medium
  low
}

/// The adversarial verifier's verdict. **`unverified` is a real state, not a missing value**: 123
/// of the 127 real findings carry it, because a verifier was cut off or never ran. Conflating it
/// with null would lose the difference between "nobody checked" and "no verdict was recorded".
enum Verified {
  confirmed
  plausible
  unverified
}

enum FindingStatus {
  open
  fixed
  /// Real, and distinct from `wont_fix`: a decision to do it later, not a decision not to.
  deferred
  skipped
  wont_fix
}

enum CheckConclusion {
  success
  failure
  cancelled
  skipped
  timed_out
  action_required
  neutral
  stale
}

/// Shipyard's terminal build states (FRM-T-008), mirrored from `BuildState` in packages/shared.
enum BuildState {
  succeeded
  failed
  cancelled
  refused
}

/// How a commit came to be attributed to a task. Declared beats message beats overlap (ADR-005).
enum AttributionSource {
  declared
  message
  file_overlap
}

/// The importer's three outcomes. Every source file gets one; silence is the failure mode.
enum ImportStatus {
  mapped
  partial
  unmapped
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ReferenceKind {
  cites
  satisfies
  violates
  relates
  supersedes
  /// A task that cannot start until another has finished. Kept in `task_dependency` as well, which
  /// is what the brief reads; this row is what makes the edge a backlink like any other.
  depends_on
  /// An ADR that builds on another. Kept in `adr_relation` as well, which the ADR graph reads. Its
  /// own kind since FRM-T-11.3: it was stored as `relates`, so an extends link and a relates link
  /// between the same two ADRs shared one row, and reversing either removed the other.
  extends
}

/// The four states the real idea documents already use. Taken from them rather than invented:
/// every project's "Feature Ideas & Future Development" sorts into Accepted, Parked — *"good
/// ideas, deliberately not now"* — and Rejected, under the heading *"do not re-litigate these"*.
/// `new` is the fourth because an idea has to exist before it has been judged.
enum IdeaStatus {
  new
  accepted
  parked
  rejected
}

enum EntityType {
  project
  repo
  phase
  requirement
  task
  adr
  decision
  risk
  term
  document
  document_section
  audit
  finding
  commit
  check_run
  release
  deployment
  tech_item
  idea
  project_idea
  guideline
  idea_score
  idea_comment
  user
  api_token
  job
  blob
  screen
  screen_version
  screen_verdict
  screen_component
  build
  group
}

enum AuditAction {
  create
  update
  delete
  restore
  undo
}

/// Who performed a mutation. The MCP shim and the importer are first-class actors.
enum ActorKind {
  user
  mcp
  importer
  webhook
  system
}

enum AuthMethod {
  password
  oidc
}

enum UserStatus {
  invited
  active
  suspended
}

enum ThrottleScope {
  account
  ip
}

// ─── Core spine ────────────────────────────────────────────────────────────

model Project {
  id String @id @default(uuid(7)) @db.Uuid

  /// `BND`, `AUTH`, `FRM`. Unique, and immutable after creation: every human ID embeds it
  /// (ADR-008, FRM-REQ-031).
  code      String           @unique
  name      String
  slug      String           @unique
  lifecycle ProjectLifecycle @default(planned)
  pitch     String?
  /// Legacy provenance: where this project's documents came from in the vault.
  vaultPath String?          @map("vault_path")
  /// Next sequence per human-ID type, so IDs are never reused after a delete.
  idCounters Json            @default("{}") @map("id_counters")
  /// The family it belongs to, or none (FRM-REQ-223). One column, so a project is in at most one.
  groupId       String?          @map("group_id") @db.Uuid
  /// Its place within its group, or among the ungrouped (FRM-REQ-226). Ties are broken by code.
  groupPosition Int              @default(0) @map("group_position")
  /// Seeded to show what a full plan looks like (`seed-example`: EXMP, NBR), never real work
  /// (FRM-T-18.9). Labelled "Sample" in the console, counted in none of Home's figures, and the one
  /// kind of project the console may remove. Set by the seed alone: no API or MCP write takes it.
  sample        Boolean          @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  repos        Repo[]
  phases       Phase[]
  requirements Requirement[]
  tasks        Task[]
  adrs         Adr[]
  decisions    Decision[]
  risks        Risk[]
  terms        Term[]
  documents    Document[]
  audits       Audit[]
  findings     Finding[]
  deployments  Deployment[]
  builds       BuildResult[]
  techItems    TechItem[]
  ideas        Idea[]
  screens      Screen[]
  cameFrom     ProjectIdea[]    @relation("ConvertedFrom")
  group        ProjectGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([lifecycle])
  @@index([groupId, groupPosition])
  @@map("project")
}

model Repo {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// `matdemers1/d3-auth`.
  fullName      String  @unique @map("full_name")
  defaultBranch String  @default("main") @map("default_branch")
  /// GitHub's numeric repository id, when the App has seen it.
  githubId      BigInt? @unique @map("github_id")
  /// Set once a full backfill has completed, so incremental ingest knows where to start.
  backfilledAt  DateTime? @map("backfilled_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits   Commit[]
  checkRuns CheckRun[]
  releases  Release[]
  builds    BuildResult[]

  @@index([projectId])
  @@map("repo")
}

model Phase {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// **Numeric, not integer.** Bindery shipped a Phase 8.5; an integer column would have made
  /// that plan unrepresentable.
  number Decimal @db.Decimal(6, 2)
  /// **Independent of `number`.** Bindery built 0–8.5, then 9–11, then 13–16, with 12 still ahead:
  /// the order phases were built in is not the order they are numbered.
  sortOrder Int    @map("sort_order")

  humanId   String      @unique @map("human_id")
  name      String
  objective String?
  status    PhaseStatus @default(planned)
  exitDemo  String?     @map("exit_demo")
  size      Size?

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  requirements Requirement[]
  documents    Document[]
  risks        Risk[]
  findings     Finding[]
  dependsOn    PhaseDependency[] @relation("phase_depends_on")
  dependedOnBy PhaseDependency[] @relation("phase_depended_on_by")

  @@unique([projectId, number])
  @@index([projectId, sortOrder])
  @@map("phase")
}

model PhaseDependency {
  phaseId   String @map("phase_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid
  /// Why the order is forced, in the plan's own words.
  reason    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  phase     Phase @relation("phase_depends_on", fields: [phaseId], references: [id], onDelete: Cascade)
  dependsOn Phase @relation("phase_depended_on_by", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([phaseId, dependsOnId])
  @@map("phase_dependency")
}

/// One task that cannot start until another has finished (FRM-REQ-179, FRM-REQ-180).
///
/// Phases have had this from the schema's first day; tasks had only `sort_order`, so "next" meant
/// "not blocked, sorted" and the brief offered a server skeleton beside the scaffold it needs. That
/// is harmless to one session reading the list top-down and wrong for several agents taking the top
/// five at once. Edges stay inside one project and never form a cycle — both enforced in the domain
/// layer, where the refusal can name the path.
model TaskDependency {
  taskId      String @map("task_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task      Task @relation("task_depends_on", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("task_depended_on_by", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependency")
}

model Requirement {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// `BND-REQ-001`. Immutable once assigned (ADR-008).
  humanId String @unique @map("human_id")
  seq     Int

  statement String
  /// The EARS shape the linter recognised. `unparsed` is stored with a warning, never rejected.
  earsPattern EarsPattern @default(unparsed) @map("ears_pattern")
  earsLintOk  Boolean     @default(false) @map("ears_lint_ok")
  earsLintNote String?    @map("ears_lint_note")
  priority    Priority    @default(M)
  source      String?
  acceptanceTest String?  @map("acceptance_test")

  /// **Nullable on purpose**: an unassigned requirement is legal and meaningful — it is the backlog.
  phaseId String? @map("phase_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    Phase?            @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  tasks    TaskRequirement[]
  findings Finding[]
  /// Component gaps citing this requirement (FRM-REQ-199) — a DS requirement, always.
  screenGaps ScreenComponent[]

  @@unique([projectId, seq])
  @@index([projectId, priority])
  @@index([phaseId])
  @@map("requirement")
}

model Task {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  phaseId   String? @map("phase_id") @db.Uuid

  /// `BND-T-0.3` — the task ID carries its phase, which is why the sequence segment may be dotted.
  humanId String     @unique @map("human_id")
  title   String
  status  TaskStatus @default(todo)
  /// Required by a check when `status` is `blocked`; enforced in the domain layer, not by the column.
  blockedReason String? @map("blocked_reason")
  size      Size?
  doneWhen  String? @map("done_when")
  /// What the task is about, in Markdown: context and the owner's words (FRM-T-017). Capped at
  /// 2000 by the API, as `foreman_create` always advertised; null when there is none.
  body      String?
  sortOrder Int     @default(0) @map("sort_order")
  /// True when the human ID was synthesized by the importer rather than authored, so a synthesized
  /// ID is never mistaken for a canonical one (FRM-REQ-045, FRM-REQ-151).
  idSynthesized Boolean @default(false) @map("id_synthesized")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        Phase?            @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  files        TaskFile[]
  requirements TaskRequirement[]
  commits      CommitTask[]
  dependsOn    TaskDependency[] @relation("task_depends_on")
  dependedOnBy TaskDependency[] @relation("task_depended_on_by")
  deployments  DeploymentTask[]

  @@index([projectId, status])
  @@index([phaseId, sortOrder])
  @@map("task")
}

model TaskFile {
  id     String @id @default(uuid(7)) @db.Uuid
  taskId String @map("task_id") @db.Uuid

  /// A repo-relative path or glob. This is what the weakest attribution signal matches against —
  /// and a match alone never marks work complete (ADR-005).
  path String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, path])
  @@index([path])
  @@map("task_file")
}

/// Many-to-many on purpose: a task satisfies several requirements, and a requirement is covered by
/// several tasks. The existing scopes of work already work this way.
model TaskRequirement {
  taskId        String @map("task_id") @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([taskId, requirementId])
  @@index([requirementId])
  @@map("task_requirement")
}

// ─── Decision records ──────────────────────────────────────────────────────

/// The only typed document: ADRs alone have a status lifecycle and a supersedes/extends DAG.
model Adr {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  humanId String    @unique @map("human_id")
  number  Int
  title   String
  status  AdrStatus @default(proposed)
  decisionAbstract String? @map("decision_abstract")
  contextMd  String? @map("context_md")
  decisionMd String? @map("decision_md")
  consequencesMd String? @map("consequences_md")
  rejectedMd String? @map("rejected_md")
  decidedOn  DateTime? @map("decided_on") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relations AdrRelation[] @relation("adr_from")
  relatedBy AdrRelation[] @relation("adr_to")
  findings  Finding[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("adr")
}

model AdrRelation {
  adrId        String          @map("adr_id") @db.Uuid
  relatedAdrId String          @map("related_adr_id") @db.Uuid
  kind         AdrRelationKind

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adr        Adr @relation("adr_from", fields: [adrId], references: [id], onDelete: Cascade)
  relatedAdr Adr @relation("adr_to", fields: [relatedAdrId], references: [id], onDelete: Cascade)

  @@id([adrId, relatedAdrId, kind])
  @@index([relatedAdrId])
  @@map("adr_relation")
}

/// A locked decision from discovery — `D-13`. Smaller than an ADR: a question, its answer, and why.
model Decision {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  humanId   String  @unique @map("human_id")
  statement String
  value     String
  rationale String?
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(6)
  supersededById String? @map("superseded_by") @db.Uuid
  /// The drift this decision accepts (FRM-T-18.15): the drifting record's human ID and the drift
  /// engine's category, both or neither. Columns rather than a `reference` row: a reference has no
  /// category (one task can drift two ways, and accepting one is not accepting the other), its
  /// kinds are mirrored into the MCP link schema whose token budget is full, and a decision's
  /// references are rewritten from its rationale on every edit.
  acceptsDriftSubject  String? @map("accepts_drift_subject")
  acceptsDriftCategory String? @map("accepts_drift_category")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supersededBy Decision?  @relation("decision_supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Decision[] @relation("decision_supersedes")

  @@index([projectId])
  @@index([projectId, acceptsDriftSubject])
  @@map("decision")
}

model Risk {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  phaseId   String? @map("phase_id") @db.Uuid

  humanId    String     @unique @map("human_id")
  title      String
  likelihood RiskLevel  @default(medium)
  impact     RiskLevel  @default(medium)
  mitigation String?
  /// The named condition that forces a re-plan. A risk without one is a worry, not a risk.
  tripwire   String?
  status     RiskStatus @default(open)
  firedAt    DateTime?  @map("fired_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("risk")
}

/// A thing somebody might build, before it is a plan (FRM-REQ-153 … FRM-REQ-158).
///
/// Deliberately thin, and that is the feature. Foreman's anti-features name "no freeform wiki or
/// note-taking" as the guardrail that stops it decaying back into the vault, and an ideas list is
/// exactly where that decay would start. So: one title, one short body, one status, and no
/// sections, revisions, attachments or nesting. An idea that needs a document is a project.
///
/// Project-scoped like every other cited record, because MCP addresses writes by human ID and a
/// `BND-IDEA-004` is what makes `foreman_update` and `foreman_set_status` reach it. An idea for
/// something that is not a project yet starts by creating the project.
model Idea {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  humanId String     @unique @map("human_id")
  seq     Int
  title   String
  /// What it is, in basic terms. Capped in the schema layer, not here, so the limit is one number
  /// in one place rather than a column type nobody reads.
  body    String?
  status  IdeaStatus @default(new)
  /// Why it was parked or rejected, and required for both.
  ///
  /// This is the whole value of writing a rejection down: the existing documents head that
  /// section *"do not re-litigate these"*, and a rejected idea with no reason gets proposed
  /// again six months later by someone who cannot tell it was considered. Same rule as a
  /// blocked task needing to say what is blocking it.
  reason  String?
  /// When it stopped being untriaged. Null while `new`.
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([projectId, status])
  @@map("idea")
}

/// A **project idea** — something that might become a project of its own, before it is one.
///
/// The one record here that belongs to no project, which is the whole point of it and the reason
/// it is a separate table rather than an `Idea` with a nullable parent (FRM-ADR-015). Its ID is
/// `PI-007`: two segments where every project-scoped ID has three, drawn from a sequence rather
/// than from a project's counter, because there is no project to count against.
///
/// `projectId` is the project it *became*, set only by converting — not the project it belongs to.
enum GuidelineStatus {
  active
  retired
}

/// A standing decision for every project (FRM-REQ-186): what was decided, why, and how to apply
/// it. Like a project idea it belongs to no project, so its `GL-004` ID comes from a sequence
/// rather than a project's counter. `decision` is the line every brief carries.
model Guideline {
  id String @id @default(uuid(7)) @db.Uuid

  humanId   String          @unique @map("human_id")
  seq       Int             @unique
  title     String
  area      String
  decision  String
  rationale String?
  guidance  String?
  status    GuidelineStatus @default(active)
  /// Every project (the default), or only those in `groups` (FRM-REQ-235).
  appliesTo GuidelineScope  @default(all) @map("applies_to")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  groups GuidelineGroup[]

  @@index([status])
  @@map("guideline")
}

enum GuidelineScope {
  all
  groups
}

/// A group's accent: one of the design system's product accents by name, never a raw colour.
enum GroupAccent {
  foreman
  shipyard
  auth
  bindery
  ui
  clearwhen
  qr
  floorspec
  neutral
}

/// A **group** — a family of projects, D3 Cloud or Dormice (FRM-ADR-024, FRM-REQ-221 … 227).
///
/// It belongs to no project, so its `GRP-001` comes from its own sequence (`project_group_seq`),
/// like a guideline's. The name is unique among live groups, case-insensitively, and the slug is
/// taken from it once, at creation, and never changes: it is what a URL carries. Both are checked
/// in the transaction that writes them, because a soft-deleted group keeps its row.
model ProjectGroup {
  id String @id @default(uuid(7)) @db.Uuid

  humanId     String      @unique @map("human_id")
  seq         Int         @unique
  name        String
  slug        String
  description String?
  siteUrl     String?     @map("site_url")
  accent      GroupAccent @default(neutral)
  position    Int         @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  projects   Project[]
  guidelines GuidelineGroup[]

  @@index([slug])
  @@index([position])
  @@map("project_group")
}

/// The groups a guideline with `applies_to = groups` applies to.
model GuidelineGroup {
  guidelineId String @map("guideline_id") @db.Uuid
  groupId     String @map("group_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guideline Guideline    @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  group     ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([guidelineId, groupId])
  @@index([groupId])
  @@map("guideline_group")
}

model ProjectIdea {
  id String @id @default(uuid(7)) @db.Uuid

  humanId String @unique @map("human_id")
  seq     Int    @unique
  title   String
  /// What it is, in basic terms. This becomes the project's pitch when it is converted, which is
  /// the reason to write more than a line here and nowhere else in the ideas feature.
  pitch   String?
  status  ProjectIdeaStatus @default(new)
  /// Why it was parked or rejected, and required for both. Same rule, same reason as an idea's.
  reason  String?
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)

  /// The project this became. Null until converted, and the only way `status` reaches `converted`.
  projectId   String?   @map("project_id") @db.Uuid
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(6)

  /// Who submitted it. Null for everything written before roles existed, and for anything a
  /// token wrote — which is why it is nullable rather than required: an idea with no author is a
  /// real state, and pretending otherwise would mean inventing one.
  submittedById String? @map("submitted_by_id") @db.Uuid
  /// What was awarded, in minor units. Integer, not a float and not a decimal that has to be
  /// serialised: money in cents is the one representation that cannot quietly lose a penny.
  fundedAmountCents Int? @map("funded_amount_cents")

  // ── The canvas (FRM-ADR-017) ──────────────────────────────────────────────
  // Named, prompted sections rather than one blank page: the structure is what keeps an idea
  // from becoming the freeform wiki Foreman's anti-features rule out, and what lets converting
  // hand the new project a brief instead of a dump. Markdown, Mermaid allowed.
  problem  String?
  audience String?
  approach String?
  whyNow   String? @map("why_now")
  risks    String?
  /// The one freeform area, and deliberately small in the console. Not counted towards maturity.
  notes    String?

  /// How much you want to do this, 1–5. Separate from how good it is, on purpose.
  excitement Int?
  tags       String[] @default([])
  /// `[{ id, text, done }]`. JSON rather than child tables: always read with the idea, never
  /// queried on their own, and small enough that a whole-list write is the natural edit.
  questions  Json     @default("[]")
  nextSteps  Json     @default("[]") @map("next_steps")
  /// `[{ id, label, url }]`
  links      Json     @default("[]")
  /// Human IDs of the ideas and projects this one builds on, competes with, or would replace.
  related    String[] @default([])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// `SetNull`, not `Cascade`: a hard-deleted project must not take the record of the idea that
  /// became it. The idea outlives the project, the way a decision outlives what it decided.
  project Project? @relation("ConvertedFrom", fields: [projectId], references: [id], onDelete: SetNull)
  /// `SetNull`: a departed colleague's account may go, and their submissions stay. The audit
  /// event still records who wrote it.
  submittedBy User? @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  scores   IdeaScore[]
  comments IdeaComment[]

  @@index([status])
  @@index([submittedById])
  @@index([tags], type: Gin)
  @@map("project_idea")
}

/// One reviewer's read on one submission (FRM-ADR-016).
///
/// Impact and effort rather than a single number, because a fund board's actual question is
/// *what do we get for what it costs* — and a lone score collapses the two into an average
/// nobody can argue with. Both are 1–5; the board is ranked by their ratio.
///
/// One row per reviewer per idea, enforced by the unique index: scoring twice is changing your
/// mind, not voting twice.
model IdeaScore {
  id String @id @default(uuid(7)) @db.Uuid

  projectIdeaId String @map("project_idea_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid

  impact Int
  effort Int
  /// Why this reviewer scored it that way. Optional, and the most useful field on the table.
  note   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  projectIdea ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectIdeaId, userId])
  @@index([projectIdeaId])
  @@map("idea_score")
}

/// Discussion on a submission (FRM-ADR-016).
///
/// `internal` is the field that makes this work for a fund board rather than a forum: the board
/// deliberates where the submitter cannot see, and answers where they can. Without it the board
/// would hold its real conversation somewhere else, and the record here would be theatre.
///
/// Deliberately **only** on a project idea and an idea. A comment on a requirement or a finding
/// is the beginning of the issue tracker Foreman exists not to be, and a test asserts the
/// boundary.
model IdeaComment {
  id String @id @default(uuid(7)) @db.Uuid

  projectIdeaId String @map("project_idea_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid

  body     String
  /// Visible to reviewers and admins only.
  internal Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  projectIdea ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectIdeaId, internal])
  @@map("idea_comment")
}

/// A pending invitation (FRM-ADR-016).
///
/// The token is stored as a hash, like an API token: a leaked database row must not be a way in.
/// Single use and time-boxed — `acceptedAt` is what spends it, and an expired invite is re-issued
/// rather than extended.
model Invite {
  id String @id @default(uuid(7)) @db.Uuid

  userId    String @unique @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  /// Who sent it. Null if the account was seeded rather than invited.
  invitedById String? @map("invited_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("invite")
}

model Term {
  id String @id @default(uuid(7)) @db.Uuid
  /// Nullable: a null project means the term is ecosystem-wide.
  projectId String? @map("project_id") @db.Uuid

  term       String
  definition String
  aliases    String[] @default([])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
  @@map("term")
}

// ─── Documents ─────────────────────────────────────────────────────────────

model Document {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  /// Phase plans only.
  phaseId   String? @map("phase_id") @db.Uuid

  kind  DocumentKind
  title String
  /// Where this document came from, when it was imported rather than authored here.
  sourcePath String? @map("source_path")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     Phase?             @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  sections  DocumentSection[]
  revisions DocumentRevision[]

  @@index([projectId, kind])
  @@map("document")
}

model DocumentSection {
  id         String @id @default(uuid(7)) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  /// Addressable, and load-bearing: this is the fragment in an MCP resource URI —
  /// `foreman://bindery/architecture#deployment` resolves to exactly one row. It is what lets
  /// Claude pull three paragraphs instead of a two-thousand-line document.
  key       String
  heading   String
  bodyMd    String @map("body_md")
  sortOrder Int    @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, key])
  @@index([documentId, sortOrder])
  @@map("document_section")
}

model DocumentRevision {
  id         String @id @default(uuid(7)) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  revisionNo Int    @map("revision_no")
  /// The whole document, sections included, as it stood.
  snapshot   Json
  actor      String
  actorKind  ActorKind @default(user) @map("actor_kind")
  note       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, revisionNo])
  @@map("document_revision")
}

// ─── Audit findings ────────────────────────────────────────────────────────

model Audit {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  humanId String      @unique @map("human_id")
  kind    AuditKind
  scope   String?
  runDate DateTime    @map("run_date") @db.Date
  verdict String?
  rounds  Int         @default(1)
  status  AuditStatus @default(running)
  /// Where the audit's own write-up lives, for the ones that predate Foreman.
  vaultPath String?   @map("vault_path")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([projectId, kind])
  @@map("audit")
}

/// The largest dataset, and not invented: every column here already existed as YAML frontmatter in
/// 127 finding files, maintained by hand.
model Finding {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  auditId   String? @map("audit_id") @db.Uuid

  humanId String   @unique @map("human_id")
  title   String
  lenses  String[] @default([])
  severity   Severity
  confidence String?
  verified   Verified?
  status     FindingStatus @default(open)

  foundRound Int?    @map("found_round")
  fixedRound Int?    @map("fixed_round")
  /// Joins to ingested reality: the commit that actually fixed it.
  fixedCommitSha String? @map("fixed_commit_sha")
  effort     String?
  /// The location **as it was written**, kept verbatim alongside the parsed rows. A real one reads
  /// `api/config.py:12-14; api/settings_store.py:70; api/main.py (no startup check in lifespan)` —
  /// prose and all — and a parse that silently dropped the prose would lose the only part naming
  /// what is wrong with the third file.
  locationRaw   String? @map("location_raw")
  observedMd    String? @map("observed_md")
  recommendationMd String? @map("recommendation_md")
  /// Why it will not be fixed (FRM-T-18.15). Its own column, not a line appended to the
  /// recommendation: that text is the reviewer's, and a verdict never edits it. Set only while the
  /// status is `wont_fix`; any other status clears it in the same write.
  wontFixReason String? @map("wont_fix_reason")

  /// What this finding contradicts, when it contradicts something.
  requirementId String? @map("requirement_id") @db.Uuid
  adrId         String? @map("adr_id") @db.Uuid
  phaseId       String? @map("phase_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audit       Audit?       @relation(fields: [auditId], references: [id], onDelete: SetNull)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  adr         Adr?         @relation(fields: [adrId], references: [id], onDelete: SetNull)
  phase       Phase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  locations   FindingLocation[]

  @@index([projectId, status])
  @@index([severity, status])
  @@index([auditId])
  @@map("finding")
}

// ─── Ingested reality ──────────────────────────────────────────────────────

/// One file a Finding points at, with the lines within it.
///
/// A child table rather than two columns on `finding`, because the real corpus needs it: **28 of
/// 127 findings name more than one file**, and eleven name several ranges within one. Two flat
/// columns can hold the first path and nothing else, which is how a location silently becomes
/// wrong rather than absent.
model FindingLocation {
  id        String @id @default(uuid(7)) @db.Uuid
  findingId String @map("finding_id") @db.Uuid

  path String
  /// `12-14`, or `42,67,69,144`, or null when the finding names a file without pinning a line.
  lines String?
  /// What the raw location said about this file in prose — "(no startup check in `lifespan`)".
  note  String?
  sortOrder Int  @default(0) @map("sort_order")

  /// Set when the file has changed since the finding was fixed (FRM-REQ-123). The regression
  /// watch: a fix whose file moved again is worth a second look, and nothing else notices.
  changedSinceFixAt DateTime? @map("changed_since_fix_at") @db.Timestamptz(6)

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, path])
  @@index([path])
  @@map("finding_location")
}

model Commit {
  id     String @id @default(uuid(7)) @db.Uuid
  repoId String @map("repo_id") @db.Uuid

  sha         String
  message     String
  author      String
  authorEmail String?  @map("author_email")
  committedAt DateTime @map("committed_at") @db.Timestamptz(6)
  additions   Int?
  deletions   Int?
  /// Set when a force push removed this SHA from the remote. **Marked, never deleted**
  /// (FRM-REQ-105): an attribution, a fix-commit reference or a release note may already cite it,
  /// and deleting the row would turn a rewritten history into a wrong one.
  orphanedAt  DateTime? @map("orphaned_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repo         Repo         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files        CommitFile[]
  attributions CommitTask[]

  @@unique([repoId, sha])
  @@index([repoId, committedAt])
  @@index([repoId, orphanedAt])
  @@map("commit")
}

model CommitFile {
  id       String @id @default(uuid(7)) @db.Uuid
  commitId String @map("commit_id") @db.Uuid

  path   String
  status String
  additions Int?
  deletions Int?

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, path])
  @@index([path])
  @@map("commit_file")
}

/// **A row with `confirmed = false` is a proposal, not a fact.** No coverage, status, brief or
/// drift calculation may read an unconfirmed row as truth (ADR-005, never-regress test #1).
model CommitTask {
  commitId String @map("commit_id") @db.Uuid
  taskId   String @map("task_id") @db.Uuid

  source     AttributionSource
  confidence Decimal           @db.Decimal(4, 3)
  confirmed  Boolean           @default(false)
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy String?          @map("confirmed_by")
  rejectedAt  DateTime?        @map("rejected_at") @db.Timestamptz(6)
  /// Which paths overlapped, or which ID the message declared — the evidence, kept for review.
  evidence    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([commitId, taskId])
  @@index([taskId, confirmed])
  @@index([confirmed])
  @@map("commit_task")
}

model CheckRun {
  id     String @id @default(uuid(7)) @db.Uuid
  repoId String @map("repo_id") @db.Uuid

  /// Not a foreign key: a check run can arrive before the commit it belongs to.
  commitSha  String           @map("commit_sha")
  name       String
  conclusion CheckConclusion?
  startedAt   DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  detailsUrl  String?         @map("details_url")
  externalId  String?         @map("external_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repo   Repo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  builds BuildResult[]

  @@unique([repoId, commitSha, name])
  @@index([repoId, completedAt])
  @@map("check_run")
}

/// A build result a deployer reported (FRM-T-008, FRM-REQ-182). **One row per build ID, ever**:
/// it is the durable record that a build was heard of, so a replay — even of a build a later one
/// has since superseded on its check run — is recognised and changes nothing. The check run is
/// the CI state the brief reads; this is the history of what was reported, including what has no
/// column there (the environment, the failed stage).
model BuildResult {
  id         String  @id @default(uuid(7)) @db.Uuid
  buildId    String  @unique @map("build_id")
  projectId  String  @map("project_id") @db.Uuid
  repoId     String  @map("repo_id") @db.Uuid
  /// The check run this build reports on. Null only if that row is ever removed.
  checkRunId String? @map("check_run_id") @db.Uuid

  app         String
  commitSha   String          @map("commit_sha")
  state       BuildState
  conclusion  CheckConclusion
  environment String?
  failedStage String?         @map("failed_stage")
  startedAt   DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt DateTime        @map("completed_at") @db.Timestamptz(6)
  detailsUrl  String?         @map("details_url")
  /// False when a result for the same commit and app that finished later was already stored: the
  /// build is recorded, and the check run keeps the newer conclusion.
  applied     Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo     Repo      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  checkRun CheckRun? @relation(fields: [checkRunId], references: [id], onDelete: SetNull)

  @@index([repoId, commitSha])
  @@index([checkRunId])
  @@index([projectId])
  @@map("build_result")
}

model Release {
  id     String @id @default(uuid(7)) @db.Uuid
  repoId String @map("repo_id") @db.Uuid

  tag         String
  name        String?
  bodyMd      String?   @map("body_md")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  prerelease  Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, tag])
  @@map("release")
}

/// Exists to serve a standing rule: every production push reports the commit SHA per image and the
/// schema revision. This table makes that a query instead of a manual check.
model Deployment {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  environment    String
  image          String
  imageSha       String    @map("image_sha")
  schemaRevision String?   @map("schema_revision")
  deployedAt     DateTime  @map("deployed_at") @db.Timestamptz(6)
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   DeploymentTask[]

  @@index([projectId, deployedAt])
  @@map("deployment")
}

/// Which tasks shipped in a deployment (FRM-T-006, SHP-REQ-088). Many-to-many: a deploy usually
/// ships several tasks, and a task can be cited by more than one deploy over its life.
model DeploymentTask {
  deploymentId String @map("deployment_id") @db.Uuid
  taskId       String @map("task_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([deploymentId, taskId])
  @@index([taskId])
  @@map("deployment_task")
}

model TechItem {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  name     String
  category String
  version  String?
  role     String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([name])
  @@map("tech_item")
}

// ─── Cross-cutting ─────────────────────────────────────────────────────────

/// Generic citation edge. **This is what makes backlinks possible**: opening `BND-ADR-005` lists
/// every requirement, task, finding and document section that cites it. Written whenever a citation
/// is parsed out of a body or created directly.
model Reference {
  id String @id @default(uuid(7)) @db.Uuid

  fromType EntityType    @map("from_type")
  fromId   String        @map("from_id") @db.Uuid
  toType   EntityType    @map("to_type")
  toId     String        @map("to_id") @db.Uuid
  kind     ReferenceKind @default(cites)
  /// The human ID as it was written, so a citation survives the entity being renamed or removed.
  citedAs  String?       @map("cited_as")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fromType, fromId, toType, toId, kind])
  @@index([toType, toId])
  @@map("reference")
}

/// Every mutation, no exceptions — MCP writes and importer writes included. Also the substrate for
/// undo: `before` is what `POST /undo/:id` replays.
model AuditEvent {
  id String @id @default(uuid(7)) @db.Uuid

  actor      String
  actorKind  ActorKind  @default(user) @map("actor_kind")
  action     AuditAction
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  /// Denormalised so an audit trail stays readable after the entity is gone.
  entityHumanId String? @map("entity_human_id")
  before Json?
  after  Json?
  /// Set when this event has been undone, and by which event.
  undoneAt      DateTime? @map("undone_at") @db.Timestamptz(6)
  undoneByEventId String? @map("undone_by_event_id") @db.Uuid
  requestId     String?   @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_event")
}

/// Issued to the MCP stdio shim. Hashed at rest, and the value is shown exactly once.
model ApiToken {
  id String @id @default(uuid(7)) @db.Uuid

  name       String
  tokenHash  String    @unique @map("token_hash")
  /// A short, non-secret prefix so a token can be identified in a list without revealing it.
  prefix     String
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([revokedAt])
  @@map("api_token")
}

/// The reconciliation report for the vault migration. **Every source file gets a row** — mapped,
/// partial or unmapped, with a reason. Silence is the failure mode (never-regress test #2).
model ImportRecord {
  id String @id @default(uuid(7)) @db.Uuid
  /// The import run, which is a job.
  jobId String @map("job_id") @db.Uuid

  sourcePath String       @map("source_path")
  entityType EntityType?  @map("entity_type")
  entityId   String?      @map("entity_id") @db.Uuid
  status     ImportStatus
  /// Why it is partial or unmapped. Required for anything that is not `mapped`.
  note       String?
  /// Bytes of the source file, so a silently truncated parse is visible.
  sourceBytes Int?        @map("source_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePath])
  @@index([jobId, status])
  @@map("import_record")
}

// ─── People, credentials and sessions (dual login, ADR-004) ────────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  email       String     @unique
  displayName String     @map("display_name")
  status      UserStatus @default(invited)
  /// Defaults to the least privilege, so an invite that forgets to say cannot hand over the
  /// board. The migration promotes every account that already existed — on a solo instance that
  /// is the one operator, who was an admin in everything but name.
  role        UserRole   @default(submitter)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// Set when the person asked to delete their account (FRM-T-15.3, FRM-ADR-022): suspended until
  /// then, restorable by an admin, and purged by the nightly job once it passes.
  deleteAfter DateTime? @map("delete_after") @db.Timestamptz(6)

  credential Credential?
  identities Identity[]
  sessions   Session[]
  invite     Invite?
  submitted  ProjectIdea[]  @relation("SubmittedBy")
  scores     IdeaScore[]
  comments   IdeaComment[]

  @@index([role])
  relayRegistrations RelayRegistration[]
  @@map("user")
}

/// The app-native path: Argon2id with a server-side pepper, and TOTP.
model Credential {
  userId String @id @map("user_id") @db.Uuid

  passwordHash     String    @map("password_hash")
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  /// Encrypted with the KEK. Null until TOTP is enrolled.
  totpSecret       String?   @map("totp_secret")
  totpConfirmedAt  DateTime? @map("totp_confirmed_at") @db.Timestamptz(6)
  /// Last accepted TOTP step, so a code cannot be replayed inside its window.
  totpLastStep     BigInt?   @map("totp_last_step")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credential")
}

/// The OIDC path. **Identities link by `(iss, sub)`, never by email** — an email is a display
/// attribute, not an identifier (ADR-004).
model Identity {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  iss String
  sub String
  /// Whatever the issuer last told us, for display only.
  claims Json?
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  relayRegistrations RelayRegistration[]

  @@unique([iss, sub])
  @@index([userId])
  @@map("identity")
}

model Session {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The cookie carries this, hashed here, so a leaked database row cannot be replayed as a cookie.
  tokenHash String     @unique @map("token_hash")
  method    AuthMethod
  /// Present for an OIDC session, so RP-initiated logout can be driven from it.
  idTokenSub String?   @map("id_token_sub")
  ip        String?
  userAgent String?    @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?  @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// A native app's session (FRM-P-14, the D3 App contract): reached with a Bearer access token —
  /// this row's token_hash, fifteen minutes, never slid — and renewed through native_refresh.
  native         Boolean @default(false)
  deviceName     String? @map("device_name")
  devicePlatform String? @map("device_platform")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshes NativeRefresh[]
  relayRegistrations RelayRegistration[]

  @@index([userId, expiresAt])
  @@map("session")
}

/// A native session's refresh tokens. A replaced one presented again is reuse: the session ends.
model NativeRefresh {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("native_refresh")
}

/// Throttle-before-hash, per account and per IP. Delays with doubling; never locks an account out,
/// because the operator is the only user and a lockout is a self-inflicted outage.
model AuthThrottle {
  scope ThrottleScope
  key   String

  failures      Int      @default(0)
  nextAllowedAt DateTime @map("next_allowed_at") @db.Timestamptz(6)
  lastFailureAt DateTime @default(now()) @map("last_failure_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("auth_throttle")
}

// ─── Jobs ──────────────────────────────────────────────────────────────────

/// A Postgres job queue, not Redis: the queue is inspectable as a table, and a failed stage
/// re-runs alone without repeating the stages before it.
model Job {
  id String @id @default(uuid(7)) @db.Uuid

  kind    String
  payload Json      @default("{}")
  status  JobStatus @default(queued)
  /// Set while a worker holds the job, with the lease that lets a dead worker's job be reclaimed.
  lockedBy  String?   @map("locked_by")
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  maxAttempts Int     @default(3) @map("max_attempts")
  lastError String?   @map("last_error")
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Set for a job that must not run twice — an ingest of one delivery, say.
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stages        JobStage[]
  importRecords ImportRecord[]

  @@index([status, availableAt])
  @@index([kind, status])
  @@map("job")
}

model JobStage {
  id    String @id @default(uuid(7)) @db.Uuid
  jobId String @map("job_id") @db.Uuid

  name      String
  sortOrder Int       @map("sort_order")
  status    JobStatus @default(queued)
  attempts  Int       @default(0)
  /// Whatever the stage produced, handed to the next stage.
  output    Json?
  lastError String?   @map("last_error")
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@index([jobId, sortOrder])
  @@map("job_stage")
}

/// A device's push registration (FRM-T-15.4, the D3 App contract's push): the relay to post to and
/// the device key every notification is sealed to. Foreman never holds an APNs token. It belongs to
/// what signed the device in — a native session, or for a D3 Auth app token the identity — and goes
/// with it; a 410 from the relay forgets it too.
model RelayRegistration {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  sessionId       String?  @unique @map("session_id") @db.Uuid
  identityId      String?  @map("identity_id") @db.Uuid
  /// P-256, X9.63 uncompressed, 65 bytes.
  devicePublicKey Bytes    @map("device_public_key")
  relayUrl        String   @map("relay_url")
  registration    String
  /// The relay's send key, sealed under the KEK: whoever holds it can push to the device.
  sendKeySealed   String   @map("send_key_sealed")
  categories      String[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([relayUrl, registration])
  @@index([userId])
  @@map("relay_registration")
}

/// An uploaded image or source file (FRM-REQ-190). **The bytes are not here**: they live once on
/// the host's disk, under `FOREMAN_BLOB_DIR`, in a file named by `sha256`. This row says what the
/// file is and who first sent it; uploading the same bytes again finds it rather than adding one.
model Blob {
  id String @id @default(uuid(7)) @db.Uuid

  /// Lowercase hex, and the file's name on disk. Unique, which is what makes storage once-only.
  sha256    String @unique
  /// What the bytes were sniffed as, never what the client declared.
  mediaType String @map("media_type")
  byteSize  Int    @map("byte_size")
  /// The actor who first uploaded it, as the audit trail names them.
  createdBy String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  screenVersions ScreenVersion[]

  @@map("blob")
}

// ─── Screens (FRM-P-12) ────────────────────────────────────────────────────

enum ScreenVersionKind {
  proposal
  capture
}

enum ScreenViewport {
  desktop
  mobile
}

enum ScreenTheme {
  light
  dark
}

/// A proposal's place in its (viewport, theme) line. Null on a capture, which is never superseded:
/// each capture is what the code looked like at one commit, and the next one does not unsay it.
enum ScreenProposalStatus {
  current
  superseded
}

enum ScreenVerdictKind {
  matches
  drifted_accepted
  drifted_fix
}

enum ScreenComponentKind {
  uses
  gap
}

/// One screen of a project's UI (FRM-REQ-189): `BND-SCR-001`, a name, the route it lives at, and
/// — through `reference` rows — the requirements and tasks it serves. What it should look like
/// (proposals, from Figma per FRM-ADR-023) and what it does look like (captures) are versions.
model Screen {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// `BND-SCR-001`, from the project's counter. Immutable once assigned (ADR-008).
  humanId String  @unique @map("human_id")
  seq     Int
  name    String
  /// The console route, e.g. `/projects/:code`. Null for a screen that is a state, not a page.
  route   String?
  /// Where the screen's frame lives in Figma, when it is known before the first proposal.
  figmaFileKey String? @map("figma_file_key")
  figmaNodeId  String? @map("figma_node_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions   ScreenVersion[]
  components ScreenComponent[]

  @@unique([projectId, seq])
  @@map("screen")
}

/// A proposal or a capture of a screen, one table for both because both are an image of the same
/// screen at one (viewport, theme). A proposal carries its Figma provenance (FRM-REQ-192) and is
/// `current` until the next proposal for the same viewport and theme supersedes it — and stays
/// readable after (FRM-REQ-193). A capture carries the commit it was taken at (FRM-REQ-194).
/// Append-only: a version is never edited, which is what makes a verdict on one mean something.
model ScreenVersion {
  id       String            @id @default(uuid(7)) @db.Uuid
  screenId String            @map("screen_id") @db.Uuid
  kind     ScreenVersionKind
  /// The image, by content address. The bytes are in the blob store, never here.
  blobSha256 String         @map("blob_sha256")
  viewport   ScreenViewport
  theme      ScreenTheme
  /// Proposals only; null on a capture.
  status     ScreenProposalStatus?

  figmaFileKey     String? @map("figma_file_key")
  figmaNodeId      String? @map("figma_node_id")
  figmaFileVersion String? @map("figma_file_version")
  /// Captures only: the full 40-character SHA the screenshot was taken at.
  commitSha        String? @map("commit_sha")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  screen   Screen          @relation(fields: [screenId], references: [id], onDelete: Cascade)
  blob     Blob            @relation(fields: [blobSha256], references: [sha256])
  verdicts ScreenVerdict[]

  @@index([screenId, kind, viewport, theme, createdAt])
  @@index([blobSha256])
  @@map("screen_version")
}

/// A reviewer's judgement of one capture against the proposal (FRM-REQ-195). Several may exist;
/// the newest is the one that stands, and the older ones are the history of how it got there.
model ScreenVerdict {
  id        String            @id @default(uuid(7)) @db.Uuid
  versionId String            @map("version_id") @db.Uuid
  verdict   ScreenVerdictKind
  /// The actor, as the audit trail names them.
  reviewer  String
  note      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version ScreenVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
  @@map("screen_verdict")
}

/// An `@d3cloud/ui` component a screen uses, or one it needs and the library lacks (FRM-REQ-199).
/// A gap cites the DS requirement that would fill it, and a `reference` row makes the screen show
/// up in that requirement's backlinks.
model ScreenComponent {
  id            String              @id @default(uuid(7)) @db.Uuid
  screenId      String              @map("screen_id") @db.Uuid
  name          String
  kind          ScreenComponentKind
  /// Gaps only, and always a requirement of the DS project.
  requirementId String?             @map("requirement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  screen      Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@unique([screenId, name, kind])
  @@index([requirementId])
  @@map("screen_component")
}
