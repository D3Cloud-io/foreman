# ---- core ----
NODE_ENV=development
PORT=3200
BASE_URL=http://localhost:3200
DATABASE_URL=postgresql://foreman:foreman@127.0.0.1:5432/foreman

# ---- secrets: boot refuses to start without these (FRM-REQ-006) ----
# openssl rand -base64 32
KEK=change-me
PEPPER=change-me
COOKIE_KEYS=change-me,change-me-previous

# ---- D3 Auth OIDC (the second of the two login paths, ADR-004) ----
# The app-native path must keep working when these are absent or unreachable.
D3AUTH_ISSUER=https://auth.d3cloud.io
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=

# ---- GitHub App (ADR-005; Check Runs API is App-only) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# ---- mail relay: the Cloudflare Worker already built for D3 Auth ----
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
ALERT_TO=

# ---- backup (ADR-007: this is the ONLY escape hatch) ----
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ---- blob store (FRM-REQ-190, FRM-REQ-191) ----
# Uploaded images and source files, each stored once and named by its SHA-256. On the host's disk,
# never in PostgreSQL. Compose sets the directory to /blobs, a named volume.
FOREMAN_BLOB_DIR=./blobs
# The largest upload accepted, in bytes. 10485760 is 10 MiB.
FOREMAN_BLOB_MAX_BYTES=10485760

# ---- which product this deployment is (FRM-ADR-016) ----
# `solo`  — Foreman as built: one operator, no roles, ideas that become projects.
# `board` — an innovation-fund deployment: several people, roles that mean something,
#           submissions that get scored, discussed and funded.
#
# Not inferred from anything. A deployment's identity is a decision somebody made, not a
# consequence of how many accounts happen to exist. The two modes must never share a database.
FOREMAN_MODE=solo

# Board mode only. ISO 4217, for rendering a funded amount; amounts are stored in minor units.
CURRENCY=USD
# How long an invitation stays usable, in hours. Re-issued rather than extended once it lapses.
INVITE_TTL_HOURS=168
